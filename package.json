  "description": "The most complete MCP server for Hostinger — 280+ tools, OAuth, HTTP transport, retry/cache, batch operations, deploy automation",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "hostinger-mcp": "./dist/index.js",
    "hostinger-api-mcp": "./dist/bin/hostinger-api-mcp.js",
    "hostinger-billing-mcp": "./dist/bin/hostinger-billing-mcp.js",
    "hostinger-dns-mcp": "./dist/bin/hostinger-dns-mcp.js",
    "hostinger-domains-mcp": "./dist/bin/hostinger-domains-mcp.js",
    "hostinger-vps-mcp": "./dist/bin/hostinger-vps-mcp.js",
    "hostinger-hosting-mcp": "./dist/bin/hostinger-hosting-mcp.js",
    "hostinger-wordpress-mcp": "./dist/bin/hostinger-wordpress-mcp.js",
    "hostinger-mail-mcp": "./dist/bin/hostinger-mail-mcp.js",
    "hostinger-reach-mcp": "./dist/bin/hostinger-reach-mcp.js",
    "hostinger-ecommerce-mcp": "./dist/bin/hostinger-ecommerce-mcp.js",
    "hostinger-agency-mcp": "./dist/bin/hostinger-agency-mcp.js",
    "hostinger-horizons-mcp": "./dist/bin/hostinger-horizons-mcp.js"
  },
  "scripts": {
    "build": "tsc",
